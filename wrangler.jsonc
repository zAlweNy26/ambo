{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambo",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-12-10",
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f9a6ed58f7bd408d95f29c705e5f2d31"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS"
    }
  ],
  "vars": {}
}
