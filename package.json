{
  "name": "ambo",
  "type": "module",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "build": "nuxi build",
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "preview": "wrangler dev -c .void-wrangler.jsonc .output/server/index.mjs --assets .output/public",
    "deploy": "void deploy",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "postinstall": "nuxi prepare && void prepare",
    "clean": "nuxi cleanup && nuxi prepare",
    "typecheck": "nuxi typecheck",
    "changelog": "changelogen --release",
    "lighthouse": "unlighthouse --site ambo.nuxt.dev",
    "ci": "bun run lint && bun run typecheck && bun run test",
    "test": "vitest --run --passWithNoTests",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix ."
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@nuxt/content": "^3.16.2",
    "@nuxt/image": "2.2.0",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "^6.0.1",
    "@pinia/nuxt": "1.0.3",
    "@vite-pwa/nuxt": "1.1.1",
    "@vueuse/nuxt": "15.0.0",
    "@vueuse/router": "^15.0.0",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/tabler": "^1.2.42",
    "@nuxt/devtools": "^4.0.0-beta.7",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vite-pwa/assets-generator": "^2.0.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "nuxt-es-toolkit": "^1.5.1",
    "typescript": "6.0.3",
    "unlighthouse": "^0.19.1",
    "vitest": "^5.0.5",
    "void": "^1.2.1",
    "vue-tsc": "^3.3.13"
  }
}
